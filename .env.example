APP_ENV=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bikewatch
POSTGRES_USER=bikewatch_app
POSTGRES_PASSWORD=replace_with_local_password

DATABASE_URL=postgresql://bikewatch_app:replace_with_local_password@localhost:5432/bikewatch

GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
APP_TIMEZONE=America/New_York
COLLECTION_INTERVAL_MINUTES=15
TRACKED_STATION_COUNT=20